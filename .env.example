# ==========================================
# Attendance Web App — environment template
# Copy to .env and fill in real values:
#   cp .env.example .env
# Restart the server after any change (vars load at startup only).
# ==========================================

# Public URL of this app (no trailing slash). Used in QR check-in links and
# email verification / password-reset links.
# Production example: https://attendance.example.edu
# If unset, the server falls back to the request Host header.
APP_URL=http://localhost:3000

# Port the HTTP server listens on (default 3000).
PORT=3000

# development | production
# In production: secure cookies, trust proxy, and a real JWT_SECRET are required.
NODE_ENV=development

# IANA timezone for class schedules (day-of-week + HH:MM windows).
# Default Africa/Accra (University of Ghana). Use UTC only if schedules are stored in UTC.
APP_TIMEZONE=Africa/Accra

# ==========================================
# Auth / sessions
# ==========================================

# Sign login JWTs. Generate with: openssl rand -hex 32
# Required in production — server refuses to start with the built-in default.
JWT_SECRET=change-this-to-a-long-random-string

# Coordinator registration is limited to these email domains (comma-separated).
# Server default if unset: ug.edu.gh,st.ug.edu.gh
# Set to empty only if you intentionally want open registration:
#   ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAIL_DOMAINS=ug.edu.gh,st.ug.edu.gh

# Session lifetime is fixed in code (SESSION_HOURS = 5) for shared lab machines.
# Change that constant in server.ts if you need a different window.

# ==========================================
# PostgreSQL
# ==========================================
# Prefer DATABASE_URL on hosted providers (Supabase, Neon, Render, Railway…).
# Use the service-role / direct connection string so the server can bypass RLS.
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/attendance_db

# Local / discrete vars (used when DATABASE_URL is not set):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me_to_your_password
PGDATABASE=attendance_db

# Most managed Postgres providers require SSL. Uncomment if needed:
# PGSSLMODE=require

# ==========================================
# Email (optional — Resend)
# ==========================================
# Without these, new accounts are auto-verified and "forgot password"
# cannot send mail (API still returns a generic success message).
#
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="QR Attendance <noreply@yourdomain.edu>"
