# APP_URL: the public URL this app is served at, used to build the check-in
# links embedded in QR codes (e.g. https://attendance.example.edu). If unset,
# it's inferred from the request's Host header — safest to set explicitly in
# production behind a proxy/CDN.
APP_URL=attendance_web_app

# NODE_ENV: set to "production" when deployed. This enables secure (HTTPS-only)
# cookies, trusts the reverse proxy for client IPs, and refuses to boot with
# the default JWT_SECRET below.
NODE_ENV=production

# ==========================================
# PostgreSQL connection
# ==========================================
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me_to_your_password
PGDATABASE=attendance_db
# Most managed Postgres providers (Render, Railway, Neon, Supabase, RDS, etc.)
# require SSL. If yours does, also set:
# PGSSLMODE=require

# Secret used to sign login session JWTs. Generate one with:
#   openssl rand -hex 32
# Required in production — the server refuses to start with the default value.
JWT_SECRET="change-this-to-a-long-random-string"


